<Window
    x:Class="Bastion.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Padding="12,8" Spacing="8">
                <TextBlock Text="Värdar" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                <Button x:Name="SyncButton" Content="&#xE895;" FontFamily="Segoe MDL2 Assets" Click="OnSyncClicked" ToolTipService.ToolTip="Synk" />
                <Button x:Name="SettingsButton" Content="&#xE713;" FontFamily="Segoe MDL2 Assets" Click="OnSettingsClicked" ToolTipService.ToolTip="Funktioner" />
                <Button x:Name="AddHostButton" Content="+" Click="OnAddHostClicked" HorizontalAlignment="Right" />
            </StackPanel>

            <TextBox x:Name="HostSearchBox" Grid.Row="1" Margin="12,0,12,8"
                     PlaceholderText="Sök värd eller tagg" TextChanged="OnHostSearchChanged" />

            <ListView x:Name="HostListView" Grid.Row="2" SelectionMode="None" ItemClick="OnHostItemClicked" IsItemClickEnabled="True">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="8,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Alias}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Subtitle}" Opacity="0.7" FontSize="12" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="&#xE712;" FontFamily="Segoe MDL2 Assets"
                                    VerticalAlignment="Center" ToolTipService.ToolTip="Mer"
                                    Click="OnHostMoreButtonClicked" Tag="{Binding}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.GroupStyle>
                    <GroupStyle HidesIfEmpty="True">
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                           Opacity="0.7" Margin="4,10,0,2" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListView.GroupStyle>
            </ListView>
        </Grid>

        <Grid Grid.Column="1">
            <StackPanel x:Name="PlaceholderPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                <TextBlock Text="Bastion" FontSize="28" HorizontalAlignment="Center" />
                <TextBlock x:Name="ContentPlaceholder"
                           Text="Inga sessioner öppna — välj en värd i listan."
                           Opacity="0.7"
                           HorizontalAlignment="Center" />
            </StackPanel>
            <TabView x:Name="SessionTabView"
                     Visibility="Collapsed"
                     TabWidthMode="Equal"
                     CanReorderTabs="True"
                     TabCloseRequested="OnTabCloseRequested" />
        </Grid>
    </Grid>
</Window>
