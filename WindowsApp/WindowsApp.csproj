<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Bastion</RootNamespace>
    <AssemblyName>bastion-gui</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Tillåter `dotnet restore` av detta Windows-riktade projekt på Linux.
         Krävs av GitHubs Automatic Dependency Submission, som kör på ubuntu
         och annars faller på NETSDK1100 — utan restore blir NuGet-grafen
         aldrig inskickad och Dependabot ser inga transitiva beroenden.
         No-op vid bygge på Windows; påverkar inte utdata. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!-- Windows App SDK / WinUI 3 -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.8249" />
    <!-- Terminalen renderas med xterm.js i en WebView2 — WinUI 3 har ingen
         inbyggd VTE-motsvarighet (se Assets/xterm/, vendrat lokalt, ingen CDN). -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2957.106" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Bastion.Core\Bastion.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\xterm\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Bastion.Core och Bastion.Core.Tests är egna projekt med egna .csproj-filer,
       men ligger under den här mappen — SDK-stilens standardglobbning
       (**/*.cs) skulle annars kompilera in deras källfiler HÄR OCKSÅ,
       vilket gav dubbletttypfel + saknad xunit-referens. -->
  <ItemGroup>
    <Compile Remove="Bastion.Core\**\*.cs" />
    <Compile Remove="Bastion.Core.Tests\**\*.cs" />
  </ItemGroup>

</Project>
